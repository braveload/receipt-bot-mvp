# API 키 없이 로컬 데모/테스트를 실행할 때 사용합니다.
EXTRACTOR=mock

# Google Cloud Vision OCR을 사용하는 현재 배포 권장 설정입니다.
# EXTRACTOR=google
GOOGLE_VISION_API_KEY=

# 유료 Claude Vision을 선택적으로 사용할 때만 설정합니다.
ANTHROPIC_API_KEY=

# 선택 사항: 설정하면 X-Webhook-Secret 헤더가 일치해야 웹훅을 처리합니다.
WEBHOOK_SECRET=

# 신고파일 링크 HMAC 서명용 비밀값입니다. 운영 환경에서는 반드시 별도 난수로 설정합니다.
REPORT_SIGNING_SECRET=
REPORT_LINK_TTL_SECONDS=600
PUBLIC_BASE_URL=https://receipt-bot-mvp.onrender.com
