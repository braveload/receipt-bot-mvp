# API 키 없이 로컬 데모/테스트를 실행할 때 사용합니다.
EXTRACTOR=mock

# Google Cloud Vision OCR을 사용하는 현재 배포 권장 설정입니다.
# EXTRACTOR=google
GOOGLE_VISION_API_KEY=

# 유료 Claude Vision을 선택적으로 사용할 때만 설정합니다.
ANTHROPIC_API_KEY=

# 선택 사항: 설정하면 X-Webhook-Secret 헤더가 일치해야 웹훅을 처리합니다.
WEBHOOK_SECRET=

# 신고파일 링크 HMAC 서명용 비밀값입니다. 운영 환경에서는 반드시 별도 난수로 설정합니다.
REPORT_SIGNING_SECRET=
REPORT_LINK_TTL_SECONDS=600
PUBLIC_BASE_URL=https://receipt-bot-mvp.onrender.com

# 운영 환경의 영구 PostgreSQL 연결 문자열입니다. 미설정 시 로컬 SQLite를 사용합니다.
DATABASE_URL=

# 원본 영수증을 공개 URL 대신 비공개 DB BLOB으로 저장합니다.
STORE_RECEIPT_IMAGES=true

# 홈페이지 문의 접수 및 네이버 SMTP 알림입니다.
# SMTP_PASSWORD에는 네이버 계정 비밀번호가 아니라 앱 비밀번호를 사용합니다.
CONTACT_EMAIL_TO=reromoon@naver.com
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_HASH_SECRET=
